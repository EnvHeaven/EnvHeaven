{
  "Artifacts": {
    "envheaven-package-01": {
      "RepoCloneFolderPath": "./artifacts/envheaven-pkg-01",
      "PackageName": "envheaven",
      "PublishAccess": "default",
      "Private": false,
      "EnvVars": {
        "EH_PACKAGE_NAME": "envheaven"
      }
    },
    "envheaven-plugin-nodejs-pnpm-01": {
      "RepoCloneFolderPath": "./artifacts/envheaven-pkg-plugin-nodejs-pnpm-01",
      "PackageName": "@envheaven/plugins-nodejs-pnpm",
      "PublishAccess": "public",
      "Private": false,
      "EnvVars": {
        "EH_PACKAGE_NAME": "@envheaven/plugins-nodejs-pnpm"
      }
    }
  },
  "RepoDeployExecutions": {
    "local-01": [
      {
        "Name": "workspace-install",
        "Execution": {
          "command": "pnpm",
          "args": ["install"],
          "cwd": "."
        }
      },
      {
        "Name": "workspace-build",
        "Execution": {
          "command": "pnpm",
          "args": ["-r", "--filter", "./artifacts/*", "build"],
          "cwd": "."
        }
      }
    ],
    "production-01": [
      {
        "Name": "workspace-install",
        "Execution": {
          "command": "pnpm",
          "args": ["install"],
          "cwd": "."
        }
      },
      {
        "Name": "workspace-build",
        "Execution": {
          "command": "pnpm",
          "args": ["-r", "--filter", "./artifacts/*", "build"],
          "cwd": "."
        }
      },
      {
        "Name": "npm-auth-check",
        "Execution": {
          "command": "npm",
          "args": ["whoami"],
          "cwd": "."
        }
      }
    ]
  },
  "ArtifactsDistributors": {
    "envheaven-package-local-01": {
      "ArtifactName": "envheaven-package-01",
      "DeployTarget": "local-01",
      "Order": 1,
      "Execution": {
        "command": "npm",
        "args": ["install", "--global", "{{GetFinalRepoCloneFolderPathOf('envheaven-package-01')}}"],
        "cwd": "."
      }
    },
    "envheaven-plugin-nodejs-pnpm-local-01": {
      "ArtifactName": "envheaven-plugin-nodejs-pnpm-01",
      "DeployTarget": "local-01",
      "Order": 2,
      "Execution": {
        "command": "npm",
        "args": ["install", "--global", "{{GetFinalRepoCloneFolderPathOf('envheaven-plugin-nodejs-pnpm-01')}}"],
        "cwd": "."
      }
    },
    "envheaven-package-production-01": {
      "ArtifactName": "envheaven-package-01",
      "DeployTarget": "production-01",
      "Order": 1,
      "Execution": {
        "command": "npm",
        "args": ["publish"],
        "cwd": "{{GetFinalRepoCloneFolderPathOf('envheaven-package-01')}}"
      }
    },
    "envheaven-plugin-nodejs-pnpm-production-01": {
      "ArtifactName": "envheaven-plugin-nodejs-pnpm-01",
      "DeployTarget": "production-01",
      "Order": 2,
      "Execution": {
        "command": "npm",
        "args": ["publish", "--access", "public"],
        "cwd": "{{GetFinalRepoCloneFolderPathOf('envheaven-plugin-nodejs-pnpm-01')}}"
      }
    },
    "broken-distributor-local-01": {
      "ArtifactName": "missing-artifact-01",
      "DeployTarget": "local-01",
      "Order": 9,
      "Execution": {
        "command": "npm",
        "args": ["install", "--global", "./missing"],
        "cwd": "."
      }
    }
  },
  "EnvMapLayers": {
    "default": {
      "Artifacts": {
        "envheaven-package-01": {
          "EnvMapName": "default",
          "EnvVars": {
            "EH_DEPLOY_TARGET": "default"
          }
        },
        "envheaven-plugin-nodejs-pnpm-01": {
          "EnvMapName": "default",
          "EnvVars": {
            "EH_DEPLOY_TARGET": "default"
          }
        }
      }
    }
  }
}
