{
  "Artifacts": {
    "envheaven-package-01": {
      "RepoCloneFolderPath": "./artifacts/envheaven-pkg-01",
      "PackageName": "envheaven",
      "Private": false
    },
    "envheaven-plugin-nodejs-pnpm-01": {
      "RepoCloneFolderPath": "./artifacts/envheaven-pkg-plugin-nodejs-pnpm-01",
      "PackageName": "@envheaven/plugins-nodejs-pnpm",
      "Private": false
    },
    "envheaven-plugin-offiline-web-ui-01": {
      "RepoCloneFolderPath": "./artifacts/envheaven-pkg-plugin-offiline-web-ui-01",
      "PackageName": "@envheaven/plugins-offiline-web-ui",
      "Private": false
    }
  },
  "RepoDeployExecutions": {
    "local-01": [
      {
        "Name": "workspace-install",
        "Execution": {
          "command": "pnpm",
          "args": ["install"],
          "cwd": "."
        }
      },
      {
        "Name": "workspace-build",
        "Execution": {
          "command": "pnpm",
          "args": ["-r", "--if-present", "run", "build"],
          "env": {
            "EH_OFFLINE_UI_ENV_JSON": "{{GetFinalEnvVarsAsJson('envheaven-plugin-offiline-web-ui-01')}}"
          },
          "cwd": "."
        }
      }
    ],
    "production-01": [
      {
        "Name": "workspace-install",
        "Execution": {
          "command": "pnpm",
          "args": ["install"],
          "cwd": "."
        }
      },
      {
        "Name": "workspace-build",
        "Execution": {
          "command": "pnpm",
          "args": ["-r", "--if-present", "run", "build"],
          "cwd": "."
        }
      },
      {
        "Name": "npm-auth-check",
        "Execution": {
          "command": "npm",
          "args": ["whoami"],
          "cwd": "."
        }
      }
    ]
  },
  "ArtifactsDistributors": {
    "envheaven-package-local-01": {
      "ArtifactName": "envheaven-package-01",
      "DeployTarget": "local-01",
      "Order": 1,
      "Execution": {
        "command": "npm",
        "args": ["install", "--global", "{{GetFinalRepoCloneFolderPathOf('envheaven-package-01')}}"],
        "cwd": "."
      }
    },
    "envheaven-plugin-nodejs-pnpm-local-01": {
      "ArtifactName": "envheaven-plugin-nodejs-pnpm-01",
      "DeployTarget": "local-01",
      "Order": 2,
      "Execution": {
        "command": "npm",
        "args": ["install", "--global", "{{GetFinalRepoCloneFolderPathOf('envheaven-plugin-nodejs-pnpm-01')}}"],
        "cwd": "."
      }
    },
    "envheaven-plugin-offiline-web-ui-local-01": {
      "ArtifactName": "envheaven-plugin-offiline-web-ui-01",
      "DeployTarget": "local-01",
      "Order": 3,
      "Execution": {
        "command": "npm",
        "args": ["install", "--global", "{{GetFinalRepoCloneFolderPathOf('envheaven-plugin-offiline-web-ui-01')}}"],
        "cwd": "."
      }
    },
    "envheaven-package-production-01": {
      "ArtifactName": "envheaven-package-01",
      "DeployTarget": "production-01",
      "Order": 1,
      "Execution": {
        "command": "npm",
        "args": ["publish"],
        "cwd": "{{GetFinalRepoCloneFolderPathOf('envheaven-package-01')}}"
      }
    },
    "envheaven-plugin-nodejs-pnpm-production-01": {
      "ArtifactName": "envheaven-plugin-nodejs-pnpm-01",
      "DeployTarget": "production-01",
      "Order": 2,
      "Execution": {
        "command": "npm",
        "args": ["publish", "--access", "public"],
        "cwd": "{{GetFinalRepoCloneFolderPathOf('envheaven-plugin-nodejs-pnpm-01')}}"
      }
    },
    "envheaven-plugin-offiline-web-ui-production-01": {
      "ArtifactName": "envheaven-plugin-offiline-web-ui-01",
      "DeployTarget": "production-01",
      "Order": 3,
      "Execution": {
        "command": "npm",
        "args": ["publish", "--access", "public"],
        "cwd": "{{GetFinalRepoCloneFolderPathOf('envheaven-plugin-offiline-web-ui-01')}}"
      }
    }
  },
  "EnvMapLayers": {
    "default": {
      "Artifacts": {
        "envheaven-package-01": {
          "EnvMapName": "default",
          "EnvVars": {
            "EH_DEPLOY_MODE": "idle"
          }
        },
        "envheaven-plugin-nodejs-pnpm-01": {
          "EnvMapName": "default",
          "EnvVars": {
            "EH_DEPLOY_MODE": "idle"
          }
        },
        "envheaven-plugin-offiline-web-ui-01": {
          "EnvMapName": "default",
          "EnvVars": {
            "EH_DEPLOY_MODE": "idle",
            "EH_ARTIFACT_VERSION": "dynamic-artifact-version"
          }
        }
      }
    }
  }
}
