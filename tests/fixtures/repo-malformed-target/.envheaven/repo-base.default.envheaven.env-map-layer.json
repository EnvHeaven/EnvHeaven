{
  "Artifacts": {
    "envheaven-type-this-01": {
      "RepoCloneFolderPath": "./repos/envheaven-type-this-01",
      "Port": 3001,
      "EnvMapName": "default",
      "EnvVars": {
        "EH_DEFAULT": "1"
      }
    }
  },
  "ArtifactsRunners": {
    "nodejs-pnpm-primary": {
      "ArtifactName": "envheaven-type-this-01",
      "Execution": {
        "pluginPackage": "@envheaven/plugins-nodejs-pnpm",
        "command": "node",
        "args": [
          "serve"
        ],
        "env": {
          "EH_ENV_MAP_NAME": "{{GetFinalEnvMapNameOf('envheaven-type-this-01')}}"
        },
        "cwd": "{{GetFinalRepoCloneFolderPathOf('envheaven-type-this-01')}}"
      }
    }
  },
  "EnvMapLayers": {
    "default": {
      "Artifacts": {
        "envheaven-type-this-01": {
          "EnvMapName": "default",
          "EnvVars": {
            "EH_TARGET": "default"
          }
        }
      }
    },
    "fake-local-01": {
      "fallback-list": [
        "default"
      ],
      "Artifacts": {
        "envheaven-type-this-01": {
          "EnvMapName": "fake-local-01",
          "EnvVars": {
            "EH_TARGET": "fake-local-01"
          }
        }
      },
      "Conditions": [
        {
          "Type": "unsupported-v0-type"
        }
      ]
    }
  }
}
