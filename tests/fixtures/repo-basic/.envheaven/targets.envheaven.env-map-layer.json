{
  "EnvMapLayers": {
    "local-01": {
      "fallback-list": [
        "default"
      ],
      "Execution": {
        "pluginPackage": "@envheaven/plugins-nodejs-pnpm",
        "command": "node",
        "args": [
          "local-01-script"
        ],
        "env": {
          "EH_TARGET": "local-01"
        },
        "cwd": "."
      }
    },
    "fake-local-01": {
      "fallback-list": [
        "default"
      ],
      "RunCommand": {
        "pluginPackage": "@envheaven/plugins-firebase-hosting-deploy",
        "command": "node",
        "args": [
          "fake-local-01-script"
        ],
        "env": {
          "EH_TARGET": "fake-local-01"
        },
        "cwd": "."
      }
    }
  }
}
