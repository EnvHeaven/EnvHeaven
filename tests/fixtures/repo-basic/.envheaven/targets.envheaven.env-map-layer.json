{
  "EnvMapLayers": {
    "local-01": {
      "fallback-list": [
        "local"
      ],
      "Execution": {
        "pluginPackage": "envheaven-test-plugin",
        "command": "node",
        "args": [
          "local-01-script"
        ],
        "env": {
          "EH_TARGET": "local-01"
        },
        "cwd": "."
      }
    },
    "fake-local-01": {
      "fallback-list": [
        "fake-local"
      ],
      "RunCommand": {
        "pluginPackage": "envheaven-test-plugin",
        "command": "node",
        "args": [
          "fake-local-01-script"
        ],
        "env": {
          "EH_TARGET": "fake-local-01"
        },
        "cwd": "."
      },
      "Conditions": [
        {
          "Type": "unsupported-v0-type"
        }
      ]
    }
  }
}
