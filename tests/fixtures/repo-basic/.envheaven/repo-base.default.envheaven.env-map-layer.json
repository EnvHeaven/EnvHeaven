{
  // Base repo model for tests.
  "fallback-list": [
    "local-user-overrides-01"
  ],
  "Artifacts": {
    "envheaven-type-this-01": {
      "RepoCloneFolderPath": "./repos/envheaven-type-this-01",
      "Port": 3001,
      "EnvMapName": "default",
      "EnvVars": {
        "EH_DEFAULT": "1"
      }
    },
    "envheaven-type-that-01": {
      "RepoCloneFolderPath": "./repos/envheaven-type-that-01",
      "Port": 3010,
      "EnvMapName": "default",
      "EnvVars": {
        "EH_DEFAULT": "1"
      }
    }
  },
  "ArtifactsRunners": {
    "nodejs-pnpm-primary": {
      "ArtifactName": "envheaven-type-this-01",
      "Execution": {
        "pluginPackage": "@envheaven/plugins-nodejs-pnpm",
        "command": "node",
        "args": [
          "serve",
          "{{GetFinalRepoCloneFolderPathOf('envheaven-type-this-01')}}",
          "{{GetFinalPortOf('envheaven-type-this-01')}}"
        ],
        "env": {
          "EH_ENV_MAP_NAME": "{{GetFinalEnvMapNameOf('envheaven-type-this-01')}}",
          "EH_ENV_VARS_JSON": "{{GetFinalEnvVarsAsJson('envheaven-type-this-01')}}"
        },
        "cwd": "{{GetFinalRepoCloneFolderPathOf('envheaven-type-this-01')}}"
      }
    },
    "firebase-hosting-secondary": {
      "ArtifactName": "envheaven-type-that-01",
      "RunCommand": {
        "pluginPackage": "@envheaven/plugins-firebase-hosting-deploy",
        "command": "node",
        "args": [
          "preview",
          "{{GetFinalEnvMapNameOf('envheaven-type-that-01')}}"
        ],
        "env": {
          "EH_ENV_VARS_JSON": "{{GetFinalEnvVarsAsJson('envheaven-type-that-01')}}"
        },
        "cwd": "{{GetFinalRepoCloneFolderPathOf('envheaven-type-that-01')}}"
      }
    },
    "broken-runner": {
      "ArtifactName": "missing-artifact-01",
      "Execution": {
        "pluginPackage": "@envheaven/plugins-nodejs-pnpm",
        "command": "node",
        "args": [
          "broken"
        ]
      }
    }
  },
  "aliases": {
    "fake-local-alias": "fake-local"
  },
  "EnvMapLayers": {
    "default": {
      "Artifacts": {
        "envheaven-type-this-01": {
          "EnvMapName": "default",
          "EnvVars": {
            "EH_TARGET": "default"
          }
        },
        "envheaven-type-that-01": {
          "EnvMapName": "default",
          "EnvVars": {
            "EH_TARGET": "default"
          }
        }
      },
      "Conditions": [
        {
          "Type": "always-force"
        }
      ]
    },
    "local": {
      "Type": "fallback-list",
      "TargetName": "local-01"
    },
    "fake-local": {
      "Type": "fallback-list",
      "TargetName": "fake-local-01"
    }
  }
}
