{
  // Base repo model for tests.
  "fallback-list": [
    "local-user-overrides-01",
  ],
  "aliases": {
    "fake-local-alias": "fake-local"
  },
  "EnvMapLayers": {
    "default": {
      "Execution": {
        "pluginPackage": "envheaven-test-plugin",
        "command": "node",
        "args": [
          "default-script"
        ],
        "env": {
          "EH_TARGET": "default"
        },
        "cwd": "."
      },
      "Conditions": [
        {
          "Type": "always-force"
        }
      ]
    },
    "local": {
      "fallback-list": [
        "default"
      ],
      "Execution": {
        "args": [
          "local-script"
        ],
        "env": {
          "EH_TARGET": "local"
        }
      }
    },
    "fake-local": {
      "fallback-list": [
        "default"
      ],
      "RunCommand": {
        "pluginPackage": "envheaven-test-plugin",
        "command": "node",
        "args": [
          "fake-local-script"
        ],
        "env": {
          "EH_TARGET": "fake-local"
        },
        "cwd": "."
      }
    }
  }
}
