{
  // Base repo model for tests.
  "fallback-list": [
    "local-user-overrides-01",
  ],
  "aliases": {
    "fake-local-alias": "fake-local"
  },
  "EnvMapLayers": {
    "default": {
      "Execution": {
        "pluginPackage": "@envheaven/plugins-nodejs-pnpm",
        "command": "node",
        "args": [
          "default-script"
        ],
        "env": {
          "EH_TARGET": "default"
        },
        "cwd": "."
      },
      "Conditions": [
        {
          "Type": "always-force"
        }
      ]
    },
    "local": {
      "Type": "fallback-list",
      "TargetName": "local-01"
    },
    "fake-local": {
      "Type": "fallback-list",
      "TargetName": "fake-local-01"
    }
  }
}
